# Значения только для локального стенда: в продакшене секреты берутся из
# секрет-хранилища, а этот файл в репозиторий не попадает.

POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_local_password

# Общий секрет подписи JWT: user-service им подписывает, остальные проверяют.
JWT_SECRET=local-dev-jwt-secret-change-me-32b
JWT_TTL=24h

# Администратор стенда: регистрация через REST всегда выдаёт роль USER,
# поэтому первый ADMIN создаётся при старте user-service.
BOOTSTRAP_ADMIN_EMAIL=admin@shop.local
BOOTSTRAP_ADMIN_PASSWORD=admin_local_password

LOG_LEVEL=info
KAFKA_PARTITIONS=3
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF=500ms
OUTBOX_POLL_INTERVAL=500ms
SHUTDOWN_TIMEOUT=20s
BCRYPT_COST=10

# true: заказ проходит NEW -> RESERVED -> COMPLETED без ручных действий.
# false: после резерва заказ остаётся в RESERVED, и его можно завершить
#        или отменить вручную (демонстрация компенсации остатка).
ORDER_AUTO_COMPLETE=true
